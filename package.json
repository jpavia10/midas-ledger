{
  "name": "midas-ledger",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --outfile=midas.js --minify && node scripts/copy-fonts.mjs",
    "dev": "esbuild src/main.js --bundle --format=esm --outfile=midas.js --servedir=. --watch",
    "check": "node --test test/ledger.test.mjs test/book.test.mjs test/vault.test.mjs"
  },
  "devDependencies": {
    "@fontsource/outfit": "^5.3.0",
    "esbuild": "^0.25.12",
    "pngjs": "^7.0.0",
    "three": "^0.164.1"
  }
}
